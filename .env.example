# Lưu dữ liệu trên hệ thống (Vercel). Chỉ cần khi triển khai lên Vercel, chạy ở máy thì không cần.
# Xem phần "Lưu dữ liệu trên hệ thống" trong README.md.

# Mật khẩu để đăng nhập vào ứng dụng
APP_PASSWORD=
# Chuỗi ngẫu nhiên dài từ 32 ký tự trở lên, dùng để ký phiên đăng nhập
SESSION_SECRET=
# Hai biến dưới đây Vercel tự thêm khi bạn kết nối kho Redis (Upstash) vào project
KV_REST_API_URL=
KV_REST_API_TOKEN=
